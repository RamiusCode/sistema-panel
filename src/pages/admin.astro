      // Al cambiar de boda se vuelve a "Todos": el filtro de la boda anterior
      // no tiene por qué aplicarse a la nueva.
      function reiniciarFiltros() {
        estado = "todos";
        filtro = "";
        $("buscador").value = "";
        for (const b of document.querySelectorAll("[data-estado]")) {
          b.classList.toggle("activo", b.dataset.estado === "todos");
