      /**
       * "Ana Lucía & Marcelo" → "ana-lucia-marcelo"
       * Se quitan los acentos y todo lo que no sea letra o número, para que
       * el identificador sea siempre válido sin que nadie tenga que pensarlo.
       */
      function comoIdentificador(texto) {
        return texto
          .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 40);
      }

      // Mientras el identificador no se toque a mano, sigue al nombre. En
      // cuanto alguien lo edita, se respeta lo que escribió.
      let slugAMano = false;

