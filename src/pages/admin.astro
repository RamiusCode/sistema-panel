---
// src/pages/admin.astro
// Panel de administración de invitados. Tema oscuro, tipografía de sistema.
// No comparte estilos con la invitación: es una herramienta, no papelería.
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070b11" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/iconos/Anillos.png" />
    <title>Panel de invitados</title>

    <style is:global>
      /* ═══════════════════════════════════════════════════════════
         TEMA OSCURO
         Sin Tailwind aquí: el panel es una herramienta aparte y así
         no arrastra el CSS de la invitación ni pelea con su paleta.
         ═══════════════════════════════════════════════════════════ */
      :root {
        --fondo:         #070b11;
        --panel:         #0e141d;
        --panel-alto:    #141c27;
        --borde:         #1f2b3a;
        --borde-suave:   #172231;
        --texto:         #e3edf5;
        --texto-tenue:   #7d8fa5;
        --neon:          #00f5a0;
        --neon-claro:    #5cffc4;
        --neon-fondo:    rgba(0, 245, 160, 0.12);
        --neon-brillo:   rgba(0, 245, 160, 0.35);
        --peligro:       #ff4d6d;
        --peligro-fondo: rgba(255, 77, 109, 0.12);
        --sombra:        0 4px 20px rgba(0, 0, 0, 0.55);
        --radio:         9px;

        color-scheme: dark;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body { height: 100%; }

      body {
        background: var(--fondo);
        color: var(--texto);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto,
                     "Helvetica Neue", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      button, input, select { font: inherit; color: inherit; }
      button { cursor: pointer; background: none; border: none; }
      .oculto { display: none !important; }

      /* ── Campos ── */
      .campo {
        width: 100%;
        background: var(--fondo);
        border: 1px solid var(--borde);
        border-radius: var(--radio);
        padding: 0.6rem 0.85rem;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
      }
      .campo:focus {
        border-color: var(--neon);
        box-shadow: 0 0 0 3px var(--neon-fondo);
      }
      .campo::placeholder { color: #56637a; }

      .etiqueta {
        display: block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--texto-tenue);
        margin-bottom: 0.4rem;
      }

      /* ── Botones ── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: var(--radio);
        padding: 0.55rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 500;
        white-space: nowrap;
        transition: background .15s, border-color .15s, opacity .15s;
      }
      .btn:disabled { opacity: .5; cursor: not-allowed; }

      .btn-neon {
        background: var(--neon);
        color: #04120c;
        font-weight: 600;
        box-shadow: 0 0 14px var(--neon-brillo);
      }
      .btn-neon:hover:not(:disabled) {
        background: var(--neon-claro);
        box-shadow: 0 0 22px var(--neon-brillo);
      }

      .btn-linea      { border: 1px solid var(--borde); color: var(--texto-tenue); }
      .btn-linea:hover{ border-color: var(--neon); color: var(--neon); background: var(--neon-fondo); }

      .btn-peligro    { border: 1px solid rgba(255,77,109,.4); color: var(--peligro); }
      .btn-peligro:hover { background: var(--peligro-fondo); border-color: var(--peligro); }

      .btn-chico { padding: 0.35rem 0.7rem; font-size: 0.8rem; }

      /* ── Tarjetas ── */
      .tarjeta {
        background: var(--panel);
        border: 1px solid var(--borde-suave);
        border-radius: 14px;
        box-shadow: var(--sombra);
      }
      .tarjeta-cabecera {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
      }
      /* Buscador y botones en una sola línea: el que cede es el buscador,
         que se encoge, en vez de empujar los botones a otro renglón. */
      .barra-acciones {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: nowrap;
      }
      .barra-acciones .campo {
        flex: 1 1 150px;
        min-width: 0;
        max-width: 230px;
      }
      .barra-acciones .btn { white-space: nowrap; flex: none; }
      /* En celular sí se apila, si no no entra */
      @media (max-width: 620px) {
        .barra-acciones { flex-wrap: wrap; }
        .barra-acciones .campo { flex: 1 1 100%; max-width: none; }
      }

      .tarjeta-titulo {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--neon);
      }
      .tarjeta-cuerpo { padding: 1.25rem; }

      /* ═══ ESTRUCTURA ═══ */
      .disposicion { display: flex; min-height: 100vh; }

      /* ── Barra lateral ── */
      .lateral {
        position: fixed;
        inset: 0 auto 0 0;
        width: 250px;
        background: var(--panel);
        border-right: 1px solid var(--borde-suave);
        display: flex;
        flex-direction: column;
        z-index: 40;
        transform: translateX(-100%);
        transition: transform .25s ease;
      }
      .lateral.abierta { transform: translateX(0); }

      .lateral-marca {
        padding: 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
      }
      .lateral-marca strong {
        display: block;
        font-size: 1rem;
        letter-spacing: 0.02em;
      }
      .lateral-marca span {
        display: block;
        font-size: 0.75rem;
        color: var(--texto-tenue);
        margin-top: 0.15rem;
      }

      .lateral-menu { padding: 0.75rem; flex: 1; }
      .lateral-item {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        width: 100%;
        padding: 0.65rem 0.8rem;
        border-radius: var(--radio);
        color: var(--texto-tenue);
        font-size: 0.92rem;
        text-align: left;
        transition: background .15s, color .15s;
      }
      .lateral-item:hover { background: var(--panel-alto); color: var(--texto); }
      .lateral-item.activo {
        position: relative;
        background: var(--neon-fondo);
        color: var(--neon);
        font-weight: 500;
      }
      .lateral-item.activo::before {
        content: "";
        position: absolute;
        left: 0; top: 20%; bottom: 20%;
        width: 3px;
        border-radius: 999px;
        background: var(--neon);
        box-shadow: 0 0 10px var(--neon-brillo);
      }
      .lateral-item svg { width: 18px; height: 18px; flex-shrink: 0; }

      .lateral-pie {
        padding: 0.75rem;
        border-top: 1px solid var(--borde-suave);
        font-size: 0.78rem;
        color: var(--texto-tenue);
      }

      .velo {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 35;
      }

      /* ── Zona principal ── */
      .principal { flex: 1; min-width: 0; display: flex; flex-direction: column; }

      .superior {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1rem;
        background: rgba(14, 20, 29, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--borde-suave);
      }
      .superior h1 { font-size: 1rem; font-weight: 600; }

      .icono-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px; height: 38px;
        border-radius: var(--radio);
        color: var(--texto-tenue);
        flex-shrink: 0;
      }
      .icono-btn:hover { background: var(--panel-alto); color: var(--texto); }
      .icono-btn svg { width: 20px; height: 20px; }

      .contenido {
        padding: 1.25rem 1rem 3rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 1100px;
        width: 100%;
        margin: 0 auto;
      }

      /* ── Cajas de resumen ── */
      .resumen {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
        gap: 0.85rem;
      }
      .caja-num {
        background: var(--panel);
        border: 1px solid var(--borde-suave);
        border-left: 3px solid var(--neon);
        border-radius: 14px;
        padding: 1rem 1.15rem;
      }
      .caja-num span {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--texto-tenue);
      }
      .caja-num strong {
        display: block;
        font-size: 1.9rem;
        font-weight: 600;
        line-height: 1.2;
        margin-top: 0.2rem;
      }

      /* ── Interruptor ── */
      .fila-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        cursor: pointer;
      }
      .switch { position: relative; width: 46px; height: 26px; flex-shrink: 0; }
      .switch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
      .switch i {
        position: absolute;
        inset: 0;
        background: #33404f;
        border-radius: 999px;
        transition: background .2s;
        pointer-events: none;
      }
      .switch i::after {
        content: "";
        position: absolute;
        top: 3px; left: 3px;
        width: 20px; height: 20px;
        background: #fff;
        border-radius: 50%;
        transition: transform .2s;
      }
      .switch input:checked + i {
        background: var(--neon);
        box-shadow: 0 0 12px var(--neon-brillo);
      }
      .switch input:checked + i::after { transform: translateX(20px); }

      /* ── Avisos ── */
      .aviso {
        border-radius: 14px;
        padding: 0.9rem 1.1rem;
        font-size: 0.9rem;
        border: 1px solid;
      }
      .aviso-atencion {
        background: var(--neon-fondo);
        border-color: rgba(0,245,160,.35);
        color: var(--neon-claro);
      }
      .aviso-error {
        background: var(--peligro-fondo);
        border-color: rgba(255,77,109,.35);
        color: var(--peligro);
      }

      /* ── Formulario de alta ── */
      .form-alta { display: grid; gap: 0.85rem; }

      /* ── Tabla ── */
      .tabla { width: 100%; border-collapse: collapse; }
      .tabla th {
        text-align: left;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--texto-tenue);
        font-weight: 600;
        padding: 0.7rem 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
        background: var(--panel-alto);
      }
      .tabla td {
        padding: 0.7rem 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
        vertical-align: middle;
      }
      /* La columna de acciones no se parte nunca */
      .tabla td.col-acciones { white-space: nowrap; width: 1%; }
      .tabla tr:last-child td { border-bottom: none; }
      .tabla tbody tr:hover { background: var(--panel-alto); }

      .celda-nombre { font-weight: 500; }
      .celda-link {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.78rem;
        color: var(--texto-tenue);
        max-width: 250px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .pastilla {
        display: inline-block;
        background: var(--neon-fondo);
        color: var(--neon);
        border-radius: 999px;
        padding: 0.15rem 0.65rem;
        font-size: 0.82rem;
        font-weight: 600;
      }

      /* Etiquetas del estado de confirmación */
      .marca-conf {
        display: inline-block;
        border-radius: 999px;
        padding: 0.15rem 0.65rem;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .marca-si {
        background: var(--neon-fondo);
        color: var(--neon);
      }
      .marca-no {
        background: var(--peligro-fondo);
        color: var(--peligro);
      }
      .marca-pendiente {
        background: rgba(125, 143, 165, 0.14);
        color: var(--texto-tenue);
      }
      /* Halo que parpadea una vez cuando una fila cambia en vivo */
      @keyframes destello-fila {
        from { background: var(--neon-fondo); }
        to   { background: transparent; }
      }
      .fila-nueva td { animation: destello-fila 1.6s ease-out; }
      /* Indicador de conexión en vivo */
      .punto-vivo {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        color: var(--texto-tenue);
        opacity: 0.45;
        transition: opacity 0.3s;
      }
      .punto-vivo i {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--texto-tenue);
      }
      .punto-vivo.vivo { opacity: 1; color: var(--neon); }
      .punto-vivo.vivo i {
        background: var(--neon);
        box-shadow: 0 0 0 0 var(--neon-brillo);
        animation: latido-vivo 2s ease-out infinite;
      }
      @keyframes latido-vivo {
        70%  { box-shadow: 0 0 0 7px rgba(0, 245, 160, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 245, 160, 0); }
      }
      @media (max-width: 560px) {
        .punto-vivo span { display: none; }
      }
      /* En escritorio los botones van en una sola línea. Antes se envolvían
         en columna y dejaban las filas larguísimas. */
      .acciones {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.4rem;
        justify-content: flex-end;
      }

      .vacio { padding: 2.5rem 1.25rem; text-align: center; color: var(--texto-tenue); }

      /* Pestañas para filtrar la lista por estado de confirmación */
      .filtros {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
        padding: 0 1.25rem 1rem;
      }
      .filtro {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        border: 1px solid var(--borde);
        background: transparent;
        color: var(--texto-tenue);
        border-radius: 999px;
        padding: .38rem .9rem;
        font: inherit;
        font-size: .84rem;
        cursor: pointer;
        transition: all .16s;
      }
      .filtro:hover { border-color: var(--neon-brillo); color: var(--texto); }
      .filtro b {
        font-size: .78rem;
        background: rgba(125, 143, 165, 0.16);
        border-radius: 999px;
        padding: 0 .4rem;
      }
      .filtro.activo {
        background: var(--neon-fondo);
        border-color: var(--neon);
        color: var(--neon);
      }
      .filtro.activo b { background: rgba(0, 245, 160, 0.18); }

      /* Aviso de bodas que ya pasaron */
      .aviso-terminadas {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        background: rgba(255, 196, 84, 0.1);
        border: 1px solid rgba(255, 196, 84, 0.35);
        border-left: 3px solid #ffc454;
        border-radius: 12px;
        padding: .9rem 1.1rem;
        margin-bottom: 1rem;
        font-size: .9rem;
      }
      .aviso-terminadas svg {
        width: 19px;
        height: 19px;
        flex: none;
        color: #ffc454;
        margin-top: .1rem;
      }
      .aviso-terminadas strong { display: block; margin-bottom: .15rem; }
      .aviso-terminadas span { color: var(--texto-tenue); }

      .marca-terminada {
        display: inline-block;
        background: rgba(255, 196, 84, 0.14);
        color: #ffc454;
        border-radius: 999px;
        padding: .12rem .6rem;
        font-size: .74rem;
        font-weight: 600;
        white-space: nowrap;
        margin-left: .5rem;
      }
      /* La fila se apaga un poco: ya no hay nada que hacer ahí */
      tr.fila-terminada .celda-nombre,
      tr.fila-terminada td { opacity: .72; }
      /* Casillas de funciones contratadas */
      .funciones-caja {
        display: flex;
        flex-direction: column;
        gap: .55rem;
        padding: .75rem .9rem;
        border: 1px solid var(--borde);
        border-radius: 10px;
        background: var(--panel-alto);
      }
      .funciones-caja label {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: .88rem;
        cursor: pointer;
      }
      .funciones-caja input { accent-color: var(--neon); width: 16px; height: 16px; }
      /* Etiquetas chicas que listan las funciones de cada boda */
      .etiqueta-fn {
        display: inline-block;
        background: var(--neon-fondo);
        color: var(--neon);
        border-radius: 6px;
        padding: .1rem .45rem;
        font-size: .72rem;
        margin-right: .25rem;
      }

      /* ── La tabla se vuelve tarjetas en pantallas chicas ── */
      @media (max-width: 767px) {
        .tabla thead { display: none; }
        .tabla, .tabla tbody, .tabla tr, .tabla td { display: block; width: 100%; }
        .tabla tr {
          border: 1px solid var(--borde-suave);
          border-radius: 12px;
          padding: 0.85rem 1rem;
          margin-bottom: 0.75rem;
          background: var(--fondo);
        }
        .tabla td { border: none; padding: 0.3rem 0; }
        .tabla td::before {
          content: attr(data-rotulo);
          display: block;
          font-size: 0.68rem;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--texto-tenue);
          margin-bottom: 0.15rem;
        }
        .acciones { flex-wrap: wrap; justify-content: flex-start; margin-top: 0.7rem; }
        .tabla td.col-acciones { width: auto; white-space: normal; }
        .celda-link { max-width: 100%; white-space: normal; word-break: break-all; }
      }

      /* ── Ventanas modales ── */
      /* align-items:center recorta el modal por arriba cuando es más alto que
         la pantalla, y entonces no hay forma de llegar a la cabecera ni a los
         botones. Con flex-start + margin:auto se centra si entra, y si no
         entra se puede desplazar. */
      .modal-fondo {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 1.25rem 1rem;
        overflow-y: auto;
        overscroll-behavior: contain;
        z-index: 60;
      }
      /* La cabecera y los botones quedan fijos; lo que se desliza es el
         contenido. Así el botón Guardar siempre está a la vista. */
      .modal {
        background: var(--panel);
        border: 1px solid var(--borde);
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0,0,0,.6);
        width: 100%;
        max-width: 420px;
        margin: auto;
        max-height: calc(100vh - 2.5rem);
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      .modal-cabecera {
        flex: none;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
        font-weight: 600;
      }
      .modal-cuerpo {
        padding: 1.25rem;
        display: grid;
        gap: 0.85rem;
        overflow-y: auto;
        min-height: 0;
      }
      .modal-pie {
        flex: none;
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--borde-suave);
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
      }


      /* ═══ MODAL DE ALTA DE BODA ═══
         Es el formulario que más se usa y el que hay que entender sin que
         nadie lo explique: por eso va más ancho, en secciones, y con las
         funciones como tarjetas en vez de casillas sueltas. */
      .modal-ancho { max-width: 620px; }

      .cabecera-rica {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1.15rem 1.4rem;
      }
      .cabecera-rica .cab-icono {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: 12px;
        background: var(--neon-fondo);
        color: var(--neon);
      }
      .cabecera-rica .cab-icono svg { width: 21px; height: 21px; }
      .cabecera-rica strong { font-size: 1.02rem; }

      .seccion { display: grid; gap: 0.85rem; }
      .seccion + .seccion {
        padding-top: 1.15rem;
        border-top: 1px solid var(--borde-suave);
      }
      .seccion-titulo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.73rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--neon);
      }
      .seccion-titulo svg { width: 15px; height: 15px; flex: none; }

      /* Dos campos por fila en escritorio, apilados en móvil */
      .campo-fila { display: grid; gap: 0.85rem; }
      @media (min-width: 620px) {
        .campo-fila { grid-template-columns: 1fr 170px; }
      }

      .ayuda {
        font-size: 0.78rem;
        color: var(--texto-tenue);
        margin-top: 0.35rem;
        line-height: 1.45;
      }
      .etiqueta-auto {
        margin-left: 0.5rem;
        font-size: 0.68rem;
        text-transform: none;
        letter-spacing: 0;
        color: var(--neon);
        background: var(--neon-fondo);
        border-radius: 999px;
        padding: 0.05rem 0.45rem;
      }

      /* Vista previa del link que van a recibir los invitados */
      .vista-link {
        background: var(--fondo);
        border: 1px dashed var(--borde);
        border-radius: 10px;
        padding: 0.6rem 0.8rem;
      }
      .vista-link code {
        font-size: 0.82rem;
        color: var(--texto);
        word-break: break-all;
      }
      .vista-link code b { color: var(--neon); font-weight: 600; }

      /* Las funciones contratadas, como tarjetas que se pulsan */
      .fn-grid { display: grid; gap: 0.6rem; }
      .fn-card {
        position: relative;
        display: grid;
        grid-template-columns: 30px 1fr 22px;
        align-items: center;
        gap: 0.7rem;
        padding: 0.65rem 0.8rem;
        border: 1px solid var(--borde);
        border-radius: 12px;
        background: var(--panel-alto);
        cursor: pointer;
        transition: border-color .18s, background .18s;
      }
      .fn-card:hover { border-color: var(--neon-brillo); }
      .fn-card input { position: absolute; opacity: 0; pointer-events: none; }
      .fn-icono {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: rgba(125, 143, 165, 0.14);
        color: var(--texto-tenue);
        transition: background .18s, color .18s;
      }
      .fn-icono svg { width: 17px; height: 17px; }
      .fn-texto strong {
        display: block;
        font-size: 0.89rem;
        font-weight: 500;
      }
      .fn-tilde {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        border: 1.5px solid var(--borde);
        display: grid;
        place-items: center;
        color: transparent;
        transition: all .18s;
      }
      .fn-tilde svg { width: 13px; height: 13px; }

      /* Encendida */
      .fn-card:has(input:checked) {
        border-color: var(--neon);
        background: var(--neon-fondo);
      }
      .fn-card:has(input:checked) .fn-icono {
        background: var(--neon-fondo);
        color: var(--neon);
      }
      .fn-card:has(input:checked) .fn-tilde {
        background: var(--neon);
        border-color: var(--neon);
        color: var(--fondo);
      }
      /* Foco por teclado: el navegador no lo marca solo porque la casilla
         real está escondida */
      .fn-card:has(input:focus-visible) { outline: 2px solid var(--neon); outline-offset: 2px; }


      /* En pantalla ancha el formulario de alta se abre en dos columnas: los
         datos a la izquierda, las funciones a la derecha. Sobra ancho y
         faltaba alto, así que entra entero sin tener que desplazar. */
      @media (min-width: 900px) {
        .modal-ancho { max-width: 880px; }
        .modal-ancho .modal-cuerpo {
          grid-template-columns: 1.1fr 1fr;
          align-items: start;
          gap: 1.4rem 1.9rem;
          padding: 1.4rem;
        }
        .modal-ancho .seccion + .seccion {
          padding-top: 0;
          border-top: 0;
        }
        .seccion-pareja    { grid-column: 1; grid-row: 1; }
        .seccion-sitio     { grid-column: 1; grid-row: 2; }
        /* Las funciones ocupan la columna derecha completa, y una línea las
           separa de los datos */
        .seccion-funciones {
          grid-column: 2;
          grid-row: 1 / span 2;
          padding-left: 1.9rem;
          border-left: 1px solid var(--borde-suave);
        }
        #boda-error { grid-column: 1 / -1; }
      }

      /* ── Aviso flotante ── */
      .toast {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        transform: translateX(-50%);
        background: var(--panel-alto);
        border: 1px solid var(--borde);
        color: var(--texto);
        border-radius: 999px;
        padding: 0.6rem 1.25rem;
        font-size: 0.88rem;
        box-shadow: var(--sombra);
        opacity: 0;
        pointer-events: none;
        transition: opacity .25s;
        z-index: 70;
      }
      .toast.visible { opacity: 1; }

      /* ── Login ── */
      .login-pantalla {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
      }
      .login-caja { width: 100%; max-width: 370px; }
      .login-marca { text-align: center; margin-bottom: 1.5rem; }
      .login-marca strong { display: block; font-size: 1.15rem; }
      .login-marca span {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--texto-tenue);
        margin-top: 0.3rem;
      }
      .login-rombo {
        width: 8px; height: 8px;
        background: var(--neon);
        box-shadow: 0 0 14px var(--neon-brillo);
        transform: rotate(45deg);
        margin: 0 auto 1rem;
      }

      /* ═══ ESCRITORIO ═══ */
      @media (min-width: 1024px) {
        .lateral { transform: translateX(0); }
        .principal { margin-left: 250px; }
        .velo, #btn-menu { display: none; }
        .contenido { padding: 1.75rem 2rem 3rem; }
        .form-alta { grid-template-columns: 1fr 130px auto; align-items: end; }
      }
    </style>
  </head>

  <body>

    <!-- ═══ CARGANDO ═══ -->
    <div id="pantalla-carga" class="login-pantalla">
      <div style="text-align: center; max-width: 420px">
        <p id="carga-texto" style="color: var(--texto-tenue)">Cargando…</p>
        <div id="carga-error" class="aviso aviso-error oculto" style="text-align: left"></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- LOGIN                                                    -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div id="pantalla-login" class="login-pantalla oculto">
      <div class="login-caja">
        <div class="login-marca">
          <div class="login-rombo"></div>
          <strong>Invitaciones</strong>
          <span>Panel de invitados</span>
        </div>

        <form id="form-login" class="tarjeta" style="padding: 1.5rem; display: grid; gap: 1rem;">
          <div>
            <label class="etiqueta" for="login-email">Correo</label>
            <input id="login-email" type="email" class="campo" required autocomplete="username" />
          </div>
          <div>
            <label class="etiqueta" for="login-pass">Contraseña</label>
            <input id="login-pass" type="password" class="campo" required autocomplete="current-password" />
          </div>
          <p id="login-error" class="aviso aviso-error oculto"></p>
          <button type="submit" id="btn-login" class="btn btn-neon" style="width: 100%">
            Entrar
          </button>
        </form>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- PANEL                                                    -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div id="pantalla-panel" class="disposicion oculto">

      <div id="velo" class="velo oculto"></div>

      <!-- ── Barra lateral ── -->
      <aside id="lateral" class="lateral">
        <div class="lateral-marca">
          <strong id="marca-boda">Invitaciones</strong>
          <span>Panel de invitados</span>
        </div>

        <nav class="lateral-menu">
          <button class="lateral-item activo" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            Invitados
          </button>
        </nav>

        <div class="lateral-pie">
          <div id="sesion-email" style="word-break: break-all"></div>
          <div id="sesion-rol" style="margin-top: .2rem; color: var(--neon)"></div>
        </div>
      </aside>

      <!-- ── Zona principal ── -->
      <div class="principal">

        <header class="superior">
          <button id="btn-menu" class="icono-btn" type="button" aria-label="Menú">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
          </button>

          <button id="btn-volver-bodas" class="btn btn-linea btn-chico oculto" type="button"
            style="margin-right:.6rem">← Bodas</button>
          <h1 style="margin-right: .6rem" id="titulo-boda">Invitados</h1>

          <!-- Se enciende cuando el canal de tiempo real está conectado -->
          <span id="punto-vivo" class="punto-vivo" title="Actualización en vivo">
            <i></i><span>En vivo</span>
          </span>

          <span style="flex: 1"></span>

          <button id="btn-salir" class="btn btn-linea btn-chico" type="button">
            Salir
          </button>
        </header>

        <main class="contenido">

          <!-- Resumen -->
          <div class="resumen">
            <div class="caja-num">
              <span>Invitados</span>
              <strong id="total-invitados">0</strong>
            </div>
            <div class="caja-num">
              <span>Pases</span>
              <strong id="total-pases">0</strong>
            </div>
            <div class="caja-num">
              <span>Confirmaron</span>
              <strong id="total-confirmados">0</strong>
            </div>
            <div class="caja-num">
              <span>Asistentes</span>
              <strong id="total-asistentes">0</strong>
            </div>
            <div class="caja-num">
              <span>Sin responder</span>
              <strong id="total-pendientes">0</strong>
            </div>
          </div>

          <!-- Aviso de registro cerrado -->
          <p id="aviso-cerrado" class="aviso aviso-atencion oculto">
            El registro de invitados está cerrado. Puedes consultar y compartir los links
            existentes, pero no agregar ni modificar.
          </p>

          <!-- Alta de invitado -->
          <section id="caja-form" class="tarjeta">
            <div class="tarjeta-cabecera">
              <span class="tarjeta-titulo">Nuevo invitado</span>
            </div>
            <div class="tarjeta-cuerpo">
              <form id="form-invitado" class="form-alta">
                <div>
                  <label class="etiqueta" for="in-nombre">Nombre</label>
                  <input
                    id="in-nombre" type="text" class="campo" required maxlength="80"
                    placeholder="Familia Molina Flores"
                  />
                </div>
                <div id="caja-in-pases">
                  <label class="etiqueta" for="in-pases">Pases</label>
                  <input id="in-pases" type="number" class="campo" min="1" max="20" value="2" required />
                </div>
                <div id="caja-in-mesa" class="oculto">
                  <label class="etiqueta" for="in-mesa">Mesa</label>
                  <input id="in-mesa" type="number" class="campo" min="1" max="200" placeholder="—" />
                </div>
                <button type="submit" id="btn-guardar" class="btn btn-neon">Agregar</button>
              </form>
              <p id="form-error" class="aviso aviso-error oculto" style="margin-top: .85rem"></p>
            </div>
          </section>

          <!-- Lista -->
          <section class="tarjeta">
            <div class="tarjeta-cabecera">
              <span class="tarjeta-titulo">Lista de invitados</span>
              <div class="barra-acciones">
                <input id="buscador" type="search" class="campo" placeholder="Buscar…" />
                <button id="btn-subir-excel" class="btn btn-linea btn-chico" type="button">
                  Subir Excel
                </button>
                <button id="btn-excel" class="btn btn-linea btn-chico" type="button">
                  Descargar Excel
                </button>
                <input id="archivo-excel" type="file" class="oculto"
                  accept=".xlsx,.xls,.csv" />
              </div>
            </div>

            <div class="filtros" id="filtros-estado">
              <button class="filtro activo" type="button" data-estado="todos">
                Todos <b id="f-todos">0</b>
              </button>
              <button class="filtro" type="button" data-estado="si">
                Confirmaron <b id="f-si">0</b>
              </button>
              <button class="filtro" type="button" data-estado="no">
                No asisten <b id="f-no">0</b>
              </button>
              <button class="filtro" type="button" data-estado="pendiente">
                Sin responder <b id="f-pendiente">0</b>
              </button>
            </div>

            <div style="overflow-x: auto">
              <table class="tabla">
                <thead>
                  <tr>
                    <th>Invitado</th>
                    <th style="width: 90px" id="th-pases">Pases</th>
                    <th style="width: 150px" id="th-confirmacion">Confirmación</th>
                    <th style="width: 70px" id="th-mesa" class="oculto">Mesa</th>
                    <th>Link</th>
                    <th class="col-acciones" style="text-align: right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="lista"></tbody>
              </table>
            </div>

            <p id="lista-vacia" class="vacio oculto">Todavía no hay invitados.</p>
          </section>
        </main>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 👑 PANTALLA: LISTA DE BODAS  (solo el super)            -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div id="pantalla-bodas" class="oculto">
      <header class="superior">
        <h1 style="flex: 1">Bodas</h1>
        <span id="super-email" style="font-size:.8rem;color:var(--texto-tenue)"></span>
        <button id="btn-salir-super" class="btn btn-linea btn-chico" type="button">Salir</button>
      </header>

      <main class="contenido">
        <div class="resumen">
          <div class="caja-num"><span>Clientes</span><strong id="total-bodas">0</strong></div>
          <div class="caja-num"><span>Invitados</span><strong id="global-invitados">0</strong></div>
          <div class="caja-num"><span>Confirmaron</span><strong id="global-confirmados">0</strong></div>
          <div class="caja-num"><span>Asistentes</span><strong id="global-asistentes">0</strong></div>
        </div>

        <p id="aviso-terminadas" class="aviso-terminadas oculto">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
            <path d="M12 9v4M12 17h.01" />
          </svg>
          <span>
            <strong id="aviso-terminadas-titulo"></strong>
            <span>Ya podés borrarlas para dejar el panel limpio. Al borrar una boda se
            borran también sus invitados, así que descargá antes lo que quieras guardar.</span>
          </span>
        </p>

        <section class="tarjeta">
          <div class="tarjeta-cabecera">
            <span class="tarjeta-titulo">Clientes</span>
            <div class="barra-acciones">
              <input id="buscador-bodas" type="search" class="campo"
                placeholder="Buscar cliente…" />
              <button id="btn-nuevo-cliente" class="btn btn-linea btn-chico" type="button">Nuevo cliente</button>
              <button id="btn-asignar" class="btn btn-linea btn-chico" type="button">Asignar cliente</button>
              <button id="btn-nueva-boda" class="btn btn-neon btn-chico" type="button">+ Nueva boda</button>
            </div>
          </div>

          <div style="overflow-x: auto">
            <table class="tabla">
              <thead>
                <tr>
                  <th>Boda</th>
                  <th style="width: 110px">Fecha</th>
                  <th style="width: 90px">Invitados</th>
                  <th style="width: 110px">Confirmaron</th>
                  <th>Funciones</th>
                  <th class="col-acciones" style="text-align: right">Acciones</th>
                </tr>
              </thead>
              <tbody id="lista-bodas"></tbody>
            </table>
          </div>

          <p id="bodas-vacio" class="vacio oculto">Todavía no hay bodas cargadas.</p>
        </section>
      </main>
    </div>

    <!-- ═══ MODAL NUEVA BODA / AJUSTES ═══ -->
    <div id="modal-boda" class="modal-fondo oculto">
      <div class="modal modal-ancho">

        <div class="modal-cabecera cabecera-rica">
          <span class="cab-icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <circle cx="12" cy="15" r="6" />
              <path d="M9 9 7.5 3h9L15 9M12 3v6" />
            </svg>
          </span>
          <strong id="modal-boda-titulo">Nueva boda</strong>
        </div>

        <form id="form-boda">
          <div class="modal-cuerpo">

            <div class="seccion seccion-pareja">
              <div class="campo-fila">
                <div>
                  <label class="etiqueta" for="bd-nombre">Nombre de la boda</label>
                  <input id="bd-nombre" type="text" class="campo" required maxlength="80"
                    placeholder="Ana Lucía &amp; Marcelo" autocomplete="off" />
                </div>
                <div>
                  <label class="etiqueta" for="bd-fecha">Fecha</label>
                  <input id="bd-fecha" type="date" class="campo" />
                </div>
              </div>

              <div>
                <label class="etiqueta" for="bd-slug">
                  Identificador
                  <span class="etiqueta-auto" id="slug-auto">automático</span>
                </label>
                <input id="bd-slug" type="text" class="campo" required maxlength="40"
                  placeholder="ana-lucia-marcelo" pattern="[a-z0-9\-]+" autocomplete="off" />
              </div>
            </div>

            <div class="seccion seccion-sitio">
              <div>
                <label class="etiqueta" for="bd-sitio">Dirección del sitio</label>
                <input id="bd-sitio" type="url" class="campo"
                  placeholder="https://boda-ana-lucia.vercel.app" autocomplete="off" />
              </div>
              <div class="vista-link">
                <code id="vista-link-texto"></code>
              </div>
            </div>

            <div class="seccion seccion-funciones">
              <div class="seccion-titulo">Funciones</div>

              <div class="fn-grid">
                <label class="fn-card">
                  <input type="checkbox" id="fn-pases" checked />
                  <span class="fn-icono">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="6" width="20" height="12" rx="2" />
                      <path d="M2 11h20M7 15h3" />
                    </svg>
                  </span>
                  <span class="fn-texto"><strong>Número de pases</strong></span>
                  <span class="fn-tilde">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                </label>

                <label class="fn-card">
                  <input type="checkbox" id="fn-confirmacion" checked />
                  <span class="fn-icono">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  <span class="fn-texto"><strong>Confirmación de asistencia</strong></span>
                  <span class="fn-tilde">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                </label>

                <label class="fn-card">
                  <input type="checkbox" id="fn-mesa" />
                  <span class="fn-icono">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <ellipse cx="12" cy="8" rx="8" ry="3.5" />
                      <path d="M12 11.5V21M8 21h8" />
                    </svg>
                  </span>
                  <span class="fn-texto"><strong>Número de mesa</strong></span>
                  <span class="fn-tilde">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                </label>

                <label class="fn-card">
                  <input type="checkbox" id="fn-acompanantes" />
                  <span class="fn-icono">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="3.5" />
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    </svg>
                  </span>
                  <span class="fn-texto"><strong>Nombres de acompañantes</strong></span>
                  <span class="fn-tilde">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                </label>
              </div>

              <div class="seccion-titulo" style="margin-top: .5rem">Permisos</div>

              <label class="fn-card">
                <input type="checkbox" id="bd-registro" checked />
                <span class="fn-icono">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                  </svg>
                </span>
                <span class="fn-texto"><strong>El cliente puede agregar invitados</strong></span>
                <span class="fn-tilde">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
              </label>
            </div>

            <p id="boda-error" class="aviso aviso-error oculto"></p>
          </div>

          <div class="modal-pie">
            <button type="button" class="btn btn-linea" data-cerrar-modal>Cancelar</button>
            <button type="submit" class="btn btn-neon" id="btn-guardar-boda">Crear boda</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ═══ MODAL BORRAR BODA ═══ -->
    <div id="modal-borrar-boda" class="modal-fondo oculto">
      <div class="modal">
        <div class="modal-cabecera">Borrar boda</div>
        <form id="form-borrar-boda">
          <div class="modal-cuerpo">
            <p class="aviso aviso-error" style="line-height:1.5">
              Se borra <strong id="bb-nombre"></strong> y también
              <strong id="bb-cuantos"></strong>. No se puede deshacer.
            </p>
            <div>
              <label class="etiqueta" for="bb-confirmacion">
                Escribí el nombre de la boda para confirmar
              </label>
              <input id="bb-confirmacion" type="text" class="campo" autocomplete="off" />
            </div>
            <p id="borrar-boda-error" class="aviso aviso-error oculto"></p>
          </div>
          <div class="modal-pie">
