      // ── Crear un cliente (usuario + boda, de una) ──
      //
      // El alta del usuario la hace una función que corre en el servidor de
      // Supabase: necesita la clave maestra, que jamás puede estar acá.
      // Ver supabase/functions/crear-cliente/index.ts

      // Contraseña fácil de dictar por teléfono: sin caracteres que se
      // confundan (0/O, 1/l/I) y sin símbolos raros.
      function claveFacil() {
        const letras = "abcdefghjkmnpqrstuvwxyz";
        const numeros = "23456789";
        const al = (s, n) => Array.from(
          crypto.getRandomValues(new Uint32Array(n)),
          (v) => s[v % s.length]
        ).join("");
        return al(letras, 4) + al(numeros, 4);
      }

      function llenarBodas(select) {
