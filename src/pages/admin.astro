      $("form-cliente").addEventListener("submit", async (e) => {
        e.preventDefault();
        mostrarError("cliente-error", "");
        if (DEMO) { cerrarModales(); avisarDemo(); return; }

        const correo = $("cl-correo").value.trim();
        const clave = $("cl-clave").value;
        const bodaId = $("cl-boda").value;
        const boda = bodas.find((b) => b.id === bodaId);

        if (clave.length < 6) {
