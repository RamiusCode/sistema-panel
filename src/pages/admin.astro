    <div id="toast" class="toast"></div>

    <script>
      import { supabase, configurado, generarCodigo } from "../lib/supabase";

      // ═══════════════════════════════════════════════════════════════════
      //  PANEL MULTI-CLIENTE
      //
      //  Dos modos, según quién entre:
      //    super  → lista de bodas, entra a cualquiera, crea clientes
      //    novio  → va directo a SU boda y no sabe que existen otras
      //
      //  ⚠️ Lo que separa a un cliente de otro son las políticas RLS de la
      //  base, no este archivo. Acá solo se decide qué se DIBUJA; si alguien
      //  manipula el JavaScript, Postgres igual le niega las filas ajenas.
      // ═══════════════════════════════════════════════════════════════════

      // ═══════════════════════════════════════════════════════════════════
      //  MODO DEMO  ·  /admin?demo=1
      //
      //  Dibuja el panel con datos inventados, sin tocar la base ni pedir
      //  login. Sirve para revisar el diseño o para mostrárselo a un cliente
      //  antes de darle acceso. No guarda nada: cualquier intento de escribir
      //  avisa y no hace nada.
      // ═══════════════════════════════════════════════════════════════════
      const DEMO =
        typeof window !== "undefined" &&
        new URLSearchParams(window.location.search).has("demo");

      const BODAS_DEMO = [
        {
          id: "demo-1", slug: "ana-lucia-marcelo", nombre: "Ana Lucía & Marcelo",
          fecha: "2026-10-10", sitio_url: "https://boda-ana-lucia.vercel.app",
          registro_abierto: true,
          funciones: { pases: true, confirmacion: true, mesa: false, acompanantes: false },
        },
        {
          id: "demo-2", slug: "marvil-carla", nombre: "Marvil & Carla",
          fecha: "2027-01-09", sitio_url: "https://boda-marvil-carla.vercel.app",
          registro_abierto: true,
          funciones: { pases: true, confirmacion: true, mesa: true, acompanantes: true },
        },
        {
          id: "demo-3", slug: "jorge-marianela", nombre: "Jorge & Marianela",
          fecha: "2027-03-20", sitio_url: null, registro_abierto: false,
          funciones: { pases: false, confirmacion: false, mesa: false, acompanantes: false },
        },
      ];

      const INVITADOS_DEMO = {
        "demo-1": [
          { id: "d1", codigo: "k7m2p", nombre: "Familia Rodríguez Vargas", pases: 3, confirmado: true,  asisten: 3,    acompanantes: [], mesa: null, confirmado_en: "2026-09-01T18:20:00Z" },
          { id: "d2", codigo: "b9nqr", nombre: "Juan Pérez",               pases: 2, confirmado: false, asisten: 0,    acompanantes: [], mesa: null, confirmado_en: "2026-09-02T09:10:00Z" },
          { id: "d3", codigo: "w3fmt", nombre: "Familia Rojas Molina",     pases: 4, confirmado: null,  asisten: null, acompanantes: [], mesa: null, confirmado_en: null },
          { id: "d4", codigo: "t6hvz", nombre: "Carla Mendoza",            pases: 1, confirmado: true,  asisten: 1,    acompanantes: [], mesa: null, confirmado_en: "2026-09-03T14:45:00Z" },
        ],
        "demo-2": [
          { id: "d5", codigo: "q2xbd", nombre: "Familia Salazar", pases: 4, confirmado: true, asisten: 3,    acompanantes: ["Ana Salazar", "Luis Salazar"], mesa: 7,  confirmado_en: "2026-08-28T20:00:00Z" },
          { id: "d6", codigo: "n8kct", nombre: "Roberto Ledezma", pases: 2, confirmado: null, asisten: null, acompanantes: [],                             mesa: 12, confirmado_en: null },
        ],
        "demo-3": [
          { id: "d7", codigo: "f4jwp", nombre: "Familia Céspedes", pases: 5, confirmado: null, asisten: null, acompanantes: [], mesa: null, confirmado_en: null },
        ],
      };

      function avisarDemo() {
        avisar("Modo demo: no se guarda nada");
      }

      // ── Estado ──
      let esSuper = false;
      let miBodaId = null;

      let bodas = [];          // solo el super las tiene
      let bodaActual = null;   // la boda que se está mirando
      let invitados = [];      // los invitados de bodaActual

      let filtro = "";        // buscador de invitados
      let estado = "todos";   // pestaña de confirmación
      let filtroBodas = "";   // buscador de clientes
      let enEdicion = null;
      let enBorrado = null;
      let bodaEnEdicion = null;

      const $ = (id) => document.getElementById(id);
      const ver = (el, visible) => el && el.classList.toggle("oculto", !visible);

      // Atajo: ¿esta boda tiene contratada tal función?
      const tiene = (fn) => Boolean(bodaActual?.funciones?.[fn]);

      // ── Aviso flotante ──
      let tiempoToast;
      function avisar(texto) {
        const t = $("toast");
        t.textContent = texto;
        t.classList.add("visible");
        clearTimeout(tiempoToast);
        tiempoToast = setTimeout(() => t.classList.remove("visible"), 2400);
      }

      function mostrarError(id, mensaje) {
        const el = $(id);
        if (!el) return;
        el.textContent = mensaje || "";
        ver(el, Boolean(mensaje));
      }

      function pantalla(cual) {
        for (const p of ["pantalla-carga", "pantalla-login", "pantalla-bodas", "pantalla-panel"]) {
          ver($(p), p === cual);
        }
      }

      function traducirError(error) {
        if (error.code === "42501" || /row-level security/i.test(error.message)) {
          return "No tienes permiso, o el registro de esta boda está cerrado.";
        }
        if (error.code === "23505") return "Ya existe algo con ese identificador.";
        return error.message;
      }

      function boton(etiqueta, clase, alPulsar) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = etiqueta;
        b.className = `btn btn-chico ${clase}`;
        b.addEventListener("click", alPulsar);
        return b;
      }

      // ═══ BARRA LATERAL (móvil) ═══
      function menuLateral(abrir) {
        $("lateral").classList.toggle("abierta", abrir);
        ver($("velo"), abrir);
      }
      $("btn-menu").addEventListener("click", () => menuLateral(true));
      $("velo").addEventListener("click", () => menuLateral(false));

      // ═══ LOGIN ═══
      $("form-login").addEventListener("submit", async (e) => {
        e.preventDefault();
        mostrarError("login-error", "");
        $("btn-login").disabled = true;

        const { error } = await supabase.auth.signInWithPassword({
          email: $("login-email").value.trim(),
          password: $("login-pass").value,
        });

        $("btn-login").disabled = false;

        if (error) {
          mostrarError(
            "login-error",
            error.message === "Invalid login credentials"
              ? "Correo o contraseña incorrectos."
              : error.message
          );
          return;
        }
        await entrar();
      });

      async function salir() {
        soltarCanal();
        await supabase.auth.signOut();
        location.reload();
      }
      $("btn-salir").addEventListener("click", salir);
      $("btn-salir-super").addEventListener("click", salir);

      // ═══ ENTRADA ═══
      async function entrar() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          pantalla("pantalla-login");
          return;
        }

        const { data: perfil } = await supabase
          .from("perfiles").select("rol, boda_id").eq("id", session.user.id).maybeSingle();

        esSuper = perfil?.rol === "super";
        miBodaId = perfil?.boda_id ?? null;

        $("sesion-email").textContent = session.user.email;
        $("super-email").textContent = session.user.email;
        $("sesion-rol").textContent = esSuper ? "Administrador" : "Novios";
        ver($("btn-volver-bodas"), esSuper);

        if (esSuper) {
          await cargarBodas();
          pantalla("pantalla-bodas");
          return;
        }

        // Un cliente sin boda asignada todavía: mejor decirlo que dejarlo
        // mirando una pantalla vacía sin entender por qué.
        if (!miBodaId) {
          pantalla("pantalla-carga");
          fallo(
            "Tu cuenta todavía no tiene una boda asignada",
            "Avisale al administrador para que te dé acceso."
          );
          return;
        }

        await abrirBoda(miBodaId);
      }

      // ═══════════════════════════════════════════════════════════════════
      //  MODO SUPER: LA LISTA DE BODAS
      // ═══════════════════════════════════════════════════════════════════

      async function cargarBodas() {
        if (DEMO) { cargarBodasDemo(); return; }

        // Dos consultas y se cruzan acá. A esta escala (decenas de bodas,
        // miles de filas) sale más barato que pedirle agregados a la base.
        const [resBodas, resInv] = await Promise.all([
          supabase.from("bodas")
            .select("id, slug, nombre, fecha, sitio_url, registro_abierto, funciones, activa")
            .order("fecha", { ascending: true }),
          supabase.from("invitados").select("boda_id, pases, confirmado, asisten"),
        ]);

        if (resBodas.error) {
          avisar("No se pudo cargar la lista de bodas");
          return;
        }

        bodas = resBodas.data ?? [];
        const filas = resInv.data ?? [];

        // Las que ya pasaron se van al final: arriba tiene que quedar lo que
        // todavía hay que atender.
        bodas.sort((a, b) => {
          const ta = yaTermino(a), tb = yaTermino(b);
          if (ta !== tb) return ta ? 1 : -1;
          return (a.fecha ?? "9999").localeCompare(b.fecha ?? "9999");
        });

        for (const b of bodas) {
          const suyos = filas.filter((i) => i.boda_id === b.id);
          b.total = suyos.length;
          b.confirmados = suyos.filter((i) => i.confirmado === true).length;
          b.asistentes = suyos.reduce(
            (s, i) => s + (i.confirmado === true ? i.asisten || 0 : 0), 0
          );
        }

        $("total-bodas").textContent = String(bodas.length);
        $("global-invitados").textContent = String(filas.length);
        $("global-confirmados").textContent =
          String(filas.filter((i) => i.confirmado === true).length);
        $("global-asistentes").textContent = String(
          filas.reduce((s, i) => s + (i.confirmado === true ? i.asisten || 0 : 0), 0)
        );

        pintarBodas();
      }

      // Se considera terminada 2 días después de la fecha: el día de la boda
      // y el siguiente todavía se usa el panel (control de puerta, cierres).
      const DIAS_DE_GRACIA = 2;

      /** Días completos desde la fecha de la boda. Null si no tiene fecha. */
      function diasDesdeLaBoda(fecha) {
        if (!fecha) return null;
        // Mediodía para que el cambio de día no dependa de la zona horaria
        const dia = new Date(fecha + "T12:00:00").getTime();
        return Math.floor((Date.now() - dia) / 86400000);
      }

      const yaTermino = (b) => {
        const d = diasDesdeLaBoda(b.fecha);
        return d !== null && d > DIAS_DE_GRACIA;
      };

      const NOMBRES_FN = {
        pases: "Pases",
        confirmacion: "Confirmación",
        mesa: "Mesa",
        acompanantes: "Acompañantes",
      };

      function pintarBodas() {
        const cuerpo = $("lista-bodas");
        cuerpo.innerHTML = "";

        const terminadas = bodas.filter(yaTermino);
        ver($("aviso-terminadas"), terminadas.length > 0);
        if (terminadas.length) {
          $("aviso-terminadas-titulo").textContent =
            terminadas.length === 1
              ? "La boda de " + terminadas[0].nombre + " ya pasó"
              : terminadas.length + " bodas ya pasaron";
        }

        // Con muchas bodas hace falta buscar. Se filtra por nombre y también
        // por identificador, que es como aparecen en la base.
        const texto = filtroBodas.trim().toLowerCase();
        const visibles = texto
          ? bodas.filter(
              (b) =>
                b.nombre.toLowerCase().includes(texto) ||
                (b.slug ?? "").toLowerCase().includes(texto)
            )
          : bodas;

        const vacio = $("bodas-vacio");
        vacio.textContent = bodas.length
          ? "Ningún cliente coincide con “" + filtroBodas.trim() + "”."
          : "Todavía no hay bodas cargadas.";
        ver(vacio, visibles.length === 0);

        for (const b of visibles) {
          const fila = document.createElement("tr");

          const tdNombre = document.createElement("td");
          tdNombre.dataset.rotulo = "Boda";
          tdNombre.className = "celda-nombre";
          tdNombre.textContent = b.nombre;

          if (yaTermino(b)) {
            fila.classList.add("fila-terminada");
            const dias = diasDesdeLaBoda(b.fecha);
            const marca = document.createElement("span");
            marca.className = "marca-terminada";
            marca.textContent =
              dias < 30
                ? "Terminada hace " + dias + " días"
                : "Terminada hace " + Math.floor(dias / 30) + " meses";
            tdNombre.append(marca);
          }

          if (!b.registro_abierto) {
            const cerrado = document.createElement("span");
            cerrado.className = "marca-conf marca-pendiente";
            cerrado.style.marginLeft = ".5rem";
            cerrado.textContent = "cerrada";
            tdNombre.append(cerrado);
          }

          const tdFecha = document.createElement("td");
          tdFecha.dataset.rotulo = "Fecha";
          tdFecha.textContent = b.fecha
            ? new Date(b.fecha + "T12:00:00").toLocaleDateString("es-BO")
            : "—";

          const tdTotal = document.createElement("td");
          tdTotal.dataset.rotulo = "Invitados";
          const p1 = document.createElement("span");
          p1.className = "pastilla";
          p1.textContent = String(b.total);
          tdTotal.append(p1);

          const tdConf = document.createElement("td");
          tdConf.dataset.rotulo = "Confirmaron";
          tdConf.textContent = b.confirmados + " · " + b.asistentes + " personas";

          const tdFn = document.createElement("td");
          tdFn.dataset.rotulo = "Funciones";
          const activas = Object.keys(NOMBRES_FN).filter((k) => b.funciones?.[k]);
