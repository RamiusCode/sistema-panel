        $("btn-crear-cliente").disabled = true;
        $("btn-crear-cliente").textContent = "Creando…";

        const { data, error } = await supabase.functions.invoke("crear-cliente", {
          body: { correo, clave, boda_id: bodaId },
        });

        $("btn-crear-cliente").disabled = false;
        $("btn-crear-cliente").textContent = "Crear cliente";

        // La función devuelve el motivo dentro del cuerpo aunque el código
        // HTTP sea de error; sin esto se vería un "Edge Function returned a
        // non-2xx status code" que no le dice nada a nadie.
        if (error) {
          let detalle = error.message;
          try {
            const cuerpo = await error.context?.json();
            if (cuerpo?.error) detalle = cuerpo.error;
          } catch { /* se queda con el mensaje genérico */ }
          mostrarError("cliente-error", detalle);
          return;
        }
        if (data?.error) {
          mostrarError("cliente-error", data.error);
          return;
        }

        cerrarModales();
        $("listo-mensaje").textContent = mensajeParaCliente(correo, clave, boda?.nombre);
        ver($("modal-listo"), true);
        avisar("Cliente creado");
