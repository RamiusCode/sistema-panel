      // ═══════════════════════════════════════════════════════════════════
      //  MODO BODA: EL PANEL DE INVITADOS
      // ═══════════════════════════════════════════════════════════════════

      async function abrirBoda(id) {
        soltarCanal();

        if (DEMO) {
          bodaActual = BODAS_DEMO.find((b) => b.id === id) ?? BODAS_DEMO[0];
          $("titulo-boda").textContent = bodaActual.nombre;
          $("marca-boda").textContent = bodaActual.nombre;
          aplicarFunciones();
          aplicarPermisos();
          pantalla("pantalla-panel");
          menuLateral(false);
          invitados = (INVITADOS_DEMO[bodaActual.id] ?? []).map((x) => ({ ...x }));
          pintarLista();
          return;
        }

        const { data, error } = await supabase
          .from("bodas")
          .select("id, slug, nombre, fecha, sitio_url, registro_abierto, funciones")
          .eq("id", id)
          .maybeSingle();

        if (error || !data) {
          avisar("No se pudo abrir esa boda");
          return;
        }

        bodaActual = data;
        $("titulo-boda").textContent = data.nombre;
        $("marca-boda").textContent = data.nombre;

        reiniciarFiltros();
        aplicarFunciones();
        aplicarPermisos();
        pantalla("pantalla-panel");
        menuLateral(false);
        await cargarInvitados();
      }

      // Muestra u oculta columnas y campos según lo que la boda tenga
      // contratado. Un solo código para todos los clientes.
      function aplicarFunciones() {
        const conf = tiene("confirmacion");
        // Los pases vienen prendidos salvo que se apaguen a propósito: las
        // bodas viejas no tienen la clave y deben seguir mostrándolos.
        const pases = bodaActual?.funciones?.pases !== false;

        ver($("th-pases"), pases);
        ver($("caja-in-pases"), pases);
        ver($("caja-ed-pases"), pases);
        ver($("total-pases").parentElement, pases);

        ver($("th-confirmacion"), conf);
        ver($("th-mesa"), tiene("mesa"));
        ver($("caja-in-mesa"), tiene("mesa"));
        ver($("caja-ed-mesa"), tiene("mesa"));
        ver($("ed-confirmado").parentElement, conf);
        ver($("total-confirmados").parentElement, conf);
        ver($("total-asistentes").parentElement, conf);
        ver($("total-pendientes").parentElement, conf);
      }

      // El super siempre puede; el cliente solo con su registro abierto
      const puedeEditar = () => esSuper || Boolean(bodaActual?.registro_abierto);

      function aplicarPermisos() {
        const permitido = puedeEditar();
        ver($("caja-form"), permitido);
        ver($("aviso-cerrado"), !permitido);
      }

      // ═══ TIEMPO REAL ═══
      // La lista se mantiene al día sin que nadie apriete F5: entra un
      // invitado desde otra pestaña, o alguien confirma desde su celular, y
      // la fila aparece o cambia sola.
      //
      // El filtro por boda_id evita recibir eventos de otras bodas. Aunque
      // llegaran, el RLS ya los habría bloqueado: esto es para no gastar red.
      let canal = null;
      let recienCambiados = new Set();

      function soltarCanal() {
        if (canal) {
          supabase.removeChannel(canal);
          canal = null;
        }
        $("punto-vivo")?.classList.remove("vivo");
      }

      function escucharCambios() {
        soltarCanal();
        if (!bodaActual) return;

        canal = supabase
          .channel("panel-" + bodaActual.id)
          .on(
            "postgres_changes",
            {
              event: "*",
              schema: "public",
              table: "invitados",
              filter: "boda_id=eq." + bodaActual.id,
            },
            (evento) => {
              if (evento.eventType === "INSERT") {
                if (invitados.some((i) => i.id === evento.new.id)) return;
                invitados.unshift(evento.new);
                recienCambiados.add(evento.new.id);
              } else if (evento.eventType === "UPDATE") {
                const i = invitados.findIndex((x) => x.id === evento.new.id);
                if (i === -1) return;
                invitados[i] = { ...invitados[i], ...evento.new };
                recienCambiados.add(evento.new.id);
              } else if (evento.eventType === "DELETE") {
                invitados = invitados.filter((x) => x.id !== evento.old.id);
              }
              pintarLista();
            }
          )
          .subscribe((estado) => {
            $("punto-vivo")?.classList.toggle("vivo", estado === "SUBSCRIBED");
          });
      }

      // ═══ DATOS ═══
      const COLUMNAS =
        "id, codigo, nombre, pases, confirmado, asisten, acompanantes, mesa, confirmado_en";

      async function cargarInvitados() {
        const { data, error } = await supabase
          .from("invitados")
          .select(COLUMNAS)
          .eq("boda_id", bodaActual.id)
          .order("creado_en", { ascending: false });

        if (error) {
          avisar("No se pudo cargar la lista");
          return;
        }
        invitados = data ?? [];
        pintarLista();
        escucharCambios();
      }

      // ── Alta de invitado ──
      $("form-invitado").addEventListener("submit", async (e) => {
        e.preventDefault();
        if (DEMO) { avisarDemo(); return; }
        mostrarError("form-error", "");

        const nombre = $("in-nombre").value.trim();
        const pases = Number($("in-pases").value);

        if (!nombre) return;
        if (!Number.isInteger(pases) || pases < 1 || pases > 30) {
          mostrarError("form-error", "Los pases deben ser un número del 1 al 30.");
          return;
        }

        const base = {
          nombre,
          pases: bodaActual?.funciones?.pases === false ? 1 : pases,
          boda_id: bodaActual.id,
        };
        if (tiene("mesa")) base.mesa = Number($("in-mesa").value) || null;

        $("btn-guardar").disabled = true;

        // El código es aleatorio y único entre TODAS las bodas: si choca con
        // uno existente, se reintenta.
        let guardado = null;
        for (let intento = 0; intento < 5; intento++) {
          const { data, error } = await supabase
            .from("invitados")
            .insert({ codigo: generarCodigo(), ...base })
            .select(COLUMNAS)
            .single();

          if (!error) { guardado = data; break; }
          if (error.code !== "23505") {      // 23505 = código repetido
            mostrarError("form-error", traducirError(error));
            break;
          }
        }

        $("btn-guardar").disabled = false;
        if (!guardado) return;

        if (!invitados.some((i) => i.id === guardado.id)) invitados.unshift(guardado);
        $("in-nombre").value = "";
        $("in-pases").value = "2";
        if (tiene("mesa")) $("in-mesa").value = "";
        $("in-nombre").focus();
        pintarLista();
        avisar("Invitado agregado");
      });

      // ── Modales ──
      for (const btn of document.querySelectorAll("[data-cerrar-modal]")) {
        btn.addEventListener("click", cerrarModales);
      }
      for (const id of ["modal-editar", "modal-borrar", "modal-boda", "modal-asignar", "modal-borrar-boda", "modal-cliente", "modal-listo", "modal-importar"]) {
        $(id).addEventListener("click", (e) => {
          if (e.target === $(id)) cerrarModales();
        });
      }
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") cerrarModales();
      });

      function cerrarModales() {
        for (const id of ["modal-editar", "modal-borrar", "modal-boda", "modal-asignar", "modal-borrar-boda", "modal-cliente", "modal-listo", "modal-importar"]) {
          ver($(id), false);
        }
        for (const id of ["editar-error", "borrar-error", "boda-error", "asignar-error", "borrar-boda-error", "cliente-error", "importar-error"]) {
          mostrarError(id, "");
        }
        enEdicion = null;
        enBorrado = null;
        bodaEnEdicion = null;
        bodaEnBorrado = null;
      }

      function abrirEditar(inv) {
        enEdicion = inv;
        $("ed-nombre").value = inv.nombre;
        $("ed-pases").value = String(inv.pases);
        $("ed-mesa").value = inv.mesa ?? "";
        $("ed-confirmado").value =
          inv.confirmado === true ? "si" : inv.confirmado === false ? "no" : "";
        $("ed-asistentes").value = String(inv.asisten ?? 0);
        sincronizarAsistentes();
        mostrarError("editar-error", "");
        ver($("modal-editar"), true);
        $("ed-nombre").focus();
      }

      // El campo "cuántos asisten" solo tiene sentido si dijo que sí.
      function sincronizarAsistentes() {
        const asiste = tiene("confirmacion") && $("ed-confirmado").value === "si";
        ver($("caja-ed-asistentes"), asiste);
        if (asiste && Number($("ed-asistentes").value) < 1) {
          $("ed-asistentes").value = String(enEdicion?.pases ?? 1);
        }
      }
      $("ed-confirmado").addEventListener("change", sincronizarAsistentes);

      $("form-editar").addEventListener("submit", async (e) => {
        e.preventDefault();
        if (DEMO) { cerrarModales(); avisarDemo(); return; }
        if (!enEdicion) return;

        const nombre = $("ed-nombre").value.trim();
        const pases = Number($("ed-pases").value);

        if (!nombre || !Number.isInteger(pases) || pases < 1 || pases > 30) {
          mostrarError("editar-error", "Revisa el nombre y que los pases estén entre 1 y 30.");
          return;
        }

        const parche = { nombre, pases };
        if (tiene("mesa")) parche.mesa = Number($("ed-mesa").value) || null;

        if (tiene("confirmacion")) {
          const respuesta = $("ed-confirmado").value;
          const confirmado = respuesta === "si" ? true : respuesta === "no" ? false : null;
          parche.confirmado = confirmado;
          parche.asisten =
            confirmado === true
              ? Math.min(Math.max(Number($("ed-asistentes").value) || 0, 1), pases)
              : 0;
          // Si la respuesta cambió se sella la fecha; si no, se deja la que había
          const cambio = confirmado !== (enEdicion.confirmado ?? null);
          parche.confirmado_en =
            confirmado === null ? null : cambio ? new Date().toISOString() : enEdicion.confirmado_en;
        }

        const { error } = await supabase
          .from("invitados").update(parche).eq("id", enEdicion.id);

        if (error) {
          mostrarError("editar-error", traducirError(error));
          return;
        }

        Object.assign(enEdicion, parche);
        cerrarModales();
        pintarLista();
        avisar("Actualizado — el link sigue sirviendo");
      });

      function abrirBorrar(inv) {
        enBorrado = inv;
        $("borrar-nombre").textContent = inv.nombre;
        mostrarError("borrar-error", "");
        ver($("modal-borrar"), true);
      }

      $("btn-borrar-confirmar").addEventListener("click", async () => {
        if (DEMO) { cerrarModales(); avisarDemo(); return; }
        if (!enBorrado) return;

        const { error } = await supabase.from("invitados").delete().eq("id", enBorrado.id);
        if (error) {
          mostrarError("borrar-error", traducirError(error));
          return;
        }

        invitados = invitados.filter((x) => x.id !== enBorrado.id);
        cerrarModales();
        pintarLista();
        avisar("Invitado borrado");
      });

      // ── Compartir ──
      // El link se arma con el dominio de ESA boda, no con el de la pestaña:
      // desde tu panel podés estar mirando la boda de otro cliente.
      function linkDeInvitado(codigo) {
        const base = (bodaActual?.sitio_url || window.location.origin).replace(/\/+$/, "");
        return `${base}/?i=${codigo}`;
      }

      async function copiar(texto, aviso = "Mensaje copiado") {
        try {
          await navigator.clipboard.writeText(texto);
        } catch {
          // Safari y contextos sin permiso de portapapeles
          const campo = document.createElement("textarea");
          campo.value = texto;
          campo.style.position = "fixed";
          campo.style.opacity = "0";
          document.body.appendChild(campo);
          campo.select();
          document.execCommand("copy");
          campo.remove();
        }
        avisar(aviso);
      }

      // Los *asteriscos* son la negrita de WhatsApp.
      function mensajeInvitacion(inv) {
        return [
          "*Con el corazón lleno de amor*",
          "",
          "Hemos decidido unir nuestras vidas y dar el paso más importante de nuestra historia.",
          "Queremos compartir este momento tan especial con las personas que más queremos.",
          "",
          "Será un honor contar con tu presencia en nuestro gran día. 🤍",
          "",
          "*Haz clic en el enlace para ver nuestra invitación*",
          "",
          linkDeInvitado(inv.codigo),
          "",
          "¡Te esperamos para celebrar juntos este hermoso comienzo!",
        ].join("\n");
      }

      /**
       * Los invitados que se están viendo: la pestaña elegida más el buscador.
       * La usan la tabla y el Excel, para que lo que se descarga sea lo mismo
       * que se ve en pantalla.
       */
      function invitadosFiltrados() {
        const texto = filtro.trim().toLowerCase();
        const porEstado = (i) =>
          estado === "todos" ? true
          : estado === "si" ? i.confirmado === true
          : estado === "no" ? i.confirmado === false
          : i.confirmado === null || i.confirmado === undefined;

        return invitados.filter(
          (i) => porEstado(i) && (!texto || i.nombre.toLowerCase().includes(texto))
        );
      }

      const NOMBRE_ESTADO = {
        todos: "",
        si: "Confirmaron",
        no: "No asisten",
        pendiente: "Sin responder",
      };

      // ═══ PINTAR LA LISTA DE INVITADOS ═══
      function pintarLista() {
        const cuerpo = $("lista");
        cuerpo.innerHTML = "";

        const visibles = invitadosFiltrados();

        $("total-invitados").textContent = String(invitados.length);
        $("total-pases").textContent = String(invitados.reduce((s, i) => s + i.pases, 0));
        $("total-confirmados").textContent = String(
          invitados.filter((i) => i.confirmado === true).length
        );
        $("total-asistentes").textContent = String(
          invitados.reduce((s, i) => s + (i.confirmado === true ? i.asisten || 0 : 0), 0)
        );
        $("total-pendientes").textContent = String(
          invitados.filter((i) => i.confirmado === null || i.confirmado === undefined).length
        );
        // Los números de cada pestaña
        ver($("filtros-estado"), tiene("confirmacion"));
        $("f-todos").textContent = String(invitados.length);
        $("f-si").textContent = String(invitados.filter((i) => i.confirmado === true).length);
        $("f-no").textContent = String(invitados.filter((i) => i.confirmado === false).length);
        $("f-pendiente").textContent = String(
          invitados.filter((i) => i.confirmado === null || i.confirmado === undefined).length
        );

        const vacia = $("lista-vacia");
        vacia.textContent =
          invitados.length === 0
            ? "Todavía no hay invitados."
            : "Ningún invitado en esta lista.";
        ver(vacia, visibles.length === 0);

        const permitido = puedeEditar();

        for (const inv of visibles) {
          const link = linkDeInvitado(inv.codigo);
          const fila = document.createElement("tr");

          const tdNombre = document.createElement("td");
          tdNombre.dataset.rotulo = "Invitado";
          tdNombre.className = "celda-nombre";
          tdNombre.textContent = inv.nombre;
          if (tiene("acompanantes") && inv.acompanantes?.length) {
            const con = document.createElement("div");
            con.style.cssText = "font-size:.78rem;color:var(--texto-tenue);margin-top:.2rem";
            con.textContent = "con " + inv.acompanantes.join(", ");
            tdNombre.append(con);
          }

          const celdas = [tdNombre];

          if (bodaActual?.funciones?.pases !== false) {
            const tdPases = document.createElement("td");
            tdPases.dataset.rotulo = "Pases";
            const pastilla = document.createElement("span");
            pastilla.className = "pastilla";
            pastilla.textContent = String(inv.pases);
            tdPases.append(pastilla);
            celdas.push(tdPases);
          }

          if (tiene("confirmacion")) {
            const tdConfirm = document.createElement("td");
            tdConfirm.dataset.rotulo = "Confirmación";
            const marca = document.createElement("span");
            marca.className = "marca-conf " + (
              inv.confirmado === true ? "marca-si"
              : inv.confirmado === false ? "marca-no"
              : "marca-pendiente"
            );
            marca.textContent =
              inv.confirmado === true ? "Confirmó · " + (inv.asisten || 0)
              : inv.confirmado === false ? "No asiste"
              : "Sin responder";
            if (inv.confirmado_en) {
              marca.title = "Respondió el " + new Date(inv.confirmado_en).toLocaleString("es-BO");
            }
            tdConfirm.append(marca);
            celdas.push(tdConfirm);
          }

          if (tiene("mesa")) {
            const tdMesa = document.createElement("td");
            tdMesa.dataset.rotulo = "Mesa";
            tdMesa.textContent = inv.mesa ? String(inv.mesa) : "—";
            celdas.push(tdMesa);
          }

          const tdLink = document.createElement("td");
          tdLink.dataset.rotulo = "Link";
          tdLink.className = "celda-link";
          tdLink.textContent = link;
          celdas.push(tdLink);

          const tdAcciones = document.createElement("td");
          tdAcciones.className = "col-acciones";
          const acciones = document.createElement("div");
          acciones.className = "acciones";

          acciones.append(
            boton("Copiar mensaje", "btn-neon", () => copiar(mensajeInvitacion(inv))),
            boton("Solo link", "btn-linea", () => copiar(link, "Link copiado"))
          );

          if (permitido) {
            acciones.append(
              boton("Editar", "btn-linea", () => abrirEditar(inv)),
              boton("Borrar", "btn-peligro", () => abrirBorrar(inv))
            );
          }

          tdAcciones.append(acciones);
          celdas.push(tdAcciones);

          if (recienCambiados.has(inv.id)) {
            fila.classList.add("fila-nueva");
            recienCambiados.delete(inv.id);
          }

          fila.append(...celdas);
          cuerpo.append(fila);
        }
      }

      $("buscador").addEventListener("input", (e) => {
        filtro = e.target.value;
        pintarLista();
      });

      for (const boton of document.querySelectorAll("[data-estado]")) {
        boton.addEventListener("click", () => {
          estado = boton.dataset.estado;
          for (const otro of document.querySelectorAll("[data-estado]")) {
