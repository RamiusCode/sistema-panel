      // ═══════════════════════════════════════════════════════════════════
      //  DESCARGAR EN EXCEL
      //
      //  La librería se carga con import() al apretar el botón: pesa cerca
      //  de un mega y casi nadie descarga. Cargarla siempre haría más lento
      //  el panel para todos.
      // ═══════════════════════════════════════════════════════════════════

      // Los mismos colores de la invitación, para que el archivo se sienta
      // parte del trabajo entregado y no una tabla cualquiera.
      const AZUL = "FF122A4D";
      const DORADO = "FFB7956B";
      const CREMA = "FFF7F3EC";

      function nombreDelArchivo(boda) {
        const limpio = (t) => t
          .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
          .replace(/[^A-Za-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
        const hoy = new Date().toISOString().slice(0, 10);
        // La pestaña va en el nombre: si se bajan varios, no se pisan.
        const cual = NOMBRE_ESTADO[estado] ? "-" + limpio(NOMBRE_ESTADO[estado]) : "";
        return "Invitados-" + limpio(boda.nombre) + cual + "-" + hoy + ".xlsx";
      }

      async function descargarExcel() {
        if (!bodaActual) return;

        // Se baja exactamente lo que se está viendo: la pestaña elegida más
        // el buscador. Si no, el archivo no coincide con la pantalla y hay
        // que explicarlo cada vez.
        const lista = invitadosFiltrados();
        if (!lista.length) {
          avisar("No hay invitados para descargar");
          return;
        }

        const boton = $("btn-excel");
        boton.disabled = true;
        boton.textContent = "Preparando…";

        try {
          const { default: ExcelJS } = await import("exceljs");

          const libro = new ExcelJS.Workbook();
          libro.creator = "Panel de invitados";
          libro.created = new Date();

          const hoja = libro.addWorksheet("Invitados", {
            views: [{ state: "frozen", ySplit: 4 }],   // los títulos quedan fijos al bajar
            pageSetup: { paperSize: 9, orientation: "portrait", fitToPage: true, fitToWidth: 1 },
          });

          const conf = tiene("confirmacion");
          const conMesa = tiene("mesa");
          const conAcomp = tiene("acompanantes");
          const conPases = bodaActual.funciones?.pases !== false;

          // ── Columnas, según lo que esa boda tenga contratado ──
          const columnas = [{ header: "Invitado", key: "nombre", width: 34 }];
          if (conPases) columnas.push({ header: "Pases", key: "pases", width: 9 });
          if (conf) {
            columnas.push({ header: "Confirmación", key: "estado", width: 16 });
            columnas.push({ header: "Asisten", key: "asisten", width: 10 });
          }
          if (conMesa) columnas.push({ header: "Mesa", key: "mesa", width: 8 });
          if (conAcomp) columnas.push({ header: "Acompañantes", key: "acompanantes", width: 32 });
          if (conf) columnas.push({ header: "Respondió el", key: "cuando", width: 18 });

          hoja.columns = columnas;

          // ── Encabezado ──
          const ultima = hoja.columnCount;
          const letra = (n) => String.fromCharCode(64 + n);

          hoja.mergeCells("A1:" + letra(ultima) + "1");
          const titulo = hoja.getCell("A1");
          titulo.value = bodaActual.nombre;
          titulo.font = { size: 18, bold: true, color: { argb: "FFFFFFFF" }, name: "Calibri" };
          titulo.alignment = { vertical: "middle", horizontal: "center" };
          titulo.fill = { type: "pattern", pattern: "solid", fgColor: { argb: AZUL } };
          hoja.getRow(1).height = 34;

          hoja.mergeCells("A2:" + letra(ultima) + "2");
          const bajada = hoja.getCell("A2");
          const partes = [NOMBRE_ESTADO[estado] || "Lista de invitados"];
          if (filtro.trim()) partes.push("Buscando “" + filtro.trim() + "”");
          if (bodaActual.fecha) {
            partes.push(new Date(bodaActual.fecha + "T12:00:00").toLocaleDateString("es-BO", {
              day: "numeric", month: "long", year: "numeric",
            }));
          }
          partes.push("Al " + new Date().toLocaleDateString("es-BO"));
          bajada.value = partes.join("  ·  ");
          bajada.font = { size: 10, italic: true, color: { argb: AZUL } };
          bajada.alignment = { vertical: "middle", horizontal: "center" };
          bajada.fill = { type: "pattern", pattern: "solid", fgColor: { argb: CREMA } };
          hoja.getRow(2).height = 20;

          // Fila 3 en blanco, para que respire
          hoja.getRow(3).height = 6;

          // ── Títulos de columna (fila 4) ──
          const cabecera = hoja.getRow(4);
          cabecera.values = columnas.map((c) => c.header);
          cabecera.height = 22;
          cabecera.eachCell((celda) => {
            celda.font = { bold: true, color: { argb: "FFFFFFFF" }, size: 11 };
            celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: DORADO } };
            celda.alignment = { vertical: "middle", horizontal: "center" };
            celda.border = { bottom: { style: "thin", color: { argb: AZUL } } };
          });

          // ── Las filas ──
          for (const inv of lista) {
            const fila = {
              nombre: inv.nombre,
              pases: inv.pases,
              estado:
                inv.confirmado === true ? "Confirmó"
                : inv.confirmado === false ? "No asiste"
                : "Sin responder",
              asisten: inv.confirmado === true ? inv.asisten ?? 0 : 0,
              mesa: inv.mesa ?? "",
              acompanantes: (inv.acompanantes ?? []).join(", "),
              cuando: inv.confirmado_en
                ? new Date(inv.confirmado_en).toLocaleDateString("es-BO")
                : "",
            };

            const r = hoja.addRow(fila);
            r.height = 19;

            r.eachCell((celda, n) => {
              celda.border = { bottom: { style: "hair", color: { argb: "FFDDD5C8" } } };
              celda.alignment = {
                vertical: "middle",
                horizontal: n === 1 || columnas[n - 1]?.key === "acompanantes" ? "left" : "center",
              };
            });

            // El estado va en color: se lee la lista de un vistazo
            if (conf) {
              const col = columnas.findIndex((c) => c.key === "estado") + 1;
              const celda = r.getCell(col);
              if (inv.confirmado === true) {
                celda.font = { bold: true, color: { argb: "FF1B7A4B" } };
                celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFE6F5EC" } };
              } else if (inv.confirmado === false) {
                celda.font = { bold: true, color: { argb: "FFA32638" } };
                celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFAE9EC" } };
              } else {
                celda.font = { color: { argb: "FF8A8A8A" } };
              }
            }
          }

          // ── Totales ──
          const totales = hoja.addRow({});
          totales.height = 24;
          hoja.mergeCells("A" + totales.number + ":" + letra(ultima) + totales.number);
          const celdaTotal = hoja.getCell("A" + totales.number);

          const resumen = [lista.length + (lista.length === 1 ? " invitado" : " invitados")];
          if (conPases) resumen.push(lista.reduce((a, i) => a + i.pases, 0) + " pases");
          if (conf) {
            resumen.push(lista.filter((i) => i.confirmado === true).length + " confirmaron");
            resumen.push(
              lista.reduce((a, i) => a + (i.confirmado === true ? i.asisten || 0 : 0), 0) +
              " asistentes"
            );
          }
          // Si se bajó solo una parte, se aclara sobre cuántos es
          if (lista.length !== invitados.length) {
            resumen.push("de " + invitados.length + " en total");
          }
          celdaTotal.value = resumen.join("   ·   ");
          celdaTotal.font = { bold: true, color: { argb: "FFFFFFFF" }, size: 11 };
          celdaTotal.alignment = { vertical: "middle", horizontal: "center" };
          celdaTotal.fill = { type: "pattern", pattern: "solid", fgColor: { argb: AZUL } };

          // ── Descargar ──
          const datos = await libro.xlsx.writeBuffer();
          const enlace = document.createElement("a");
          enlace.href = URL.createObjectURL(
            new Blob([datos], {
              type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            })
          );
          enlace.download = nombreDelArchivo(bodaActual);
          enlace.click();
          URL.revokeObjectURL(enlace.href);

          avisar("Excel descargado");
        } catch (e) {
          avisar("No se pudo generar el Excel");
          console.error(e);
        } finally {
          boton.disabled = false;
          boton.textContent = "Descargar Excel";
        }
      }

      $("btn-excel").addEventListener("click", descargarExcel);


      // ═══════════════════════════════════════════════════════════════════
      //  SUBIR UNA LISTA DESDE EXCEL
      //
      //  Muchos novios ya tienen su lista armada en Excel, cada uno con sus
      //  títulos y su orden. En vez de pedirles una plantilla, se buscan las
      //  columnas por el nombre del encabezado, venga como venga.
      // ═══════════════════════════════════════════════════════════════════

      // Sin acentos, sin mayúsculas, sin espacios de sobra: así "PASES  " y
      // "Pases" son lo mismo.
      function normalizar(texto) {
        return String(texto ?? "")
          .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
          .toLowerCase().trim();
      }

      // Cómo suele llamarse cada columna en las listas que manda la gente
      const SINONIMOS = {
        nombre: ["nombre", "nombres", "invitado", "invitados", "apellido", "apellidos",
                 "familia", "nombre completo", "nombre y apellido", "name", "guest"],
        pases: ["pases", "pase", "cantidad", "cant", "cupos", "cupo", "boletos", "tickets",
                "entradas", "personas", "nro personas", "n personas", "cantidad de pases"],
        mesa: ["mesa", "mesas", "nro mesa", "n mesa", "numero de mesa", "table"],
      };

      function queColumnaEs(titulo) {
        const t = normalizar(titulo);
        if (!t) return null;
        for (const [campo, nombres] of Object.entries(SINONIMOS)) {
          if (nombres.includes(t)) return campo;
        }
        // Si no coincide exacto, alcanza con que empiece igual: "pases (adultos)"
        for (const [campo, nombres] of Object.entries(SINONIMOS)) {
          if (nombres.some((n) => t.startsWith(n))) return campo;
        }
        return null;
      }

      /**
       * Busca la fila de títulos. No siempre es la primera: las listas suelen
       * traer el nombre de los novios y una fila en blanco arriba.
       * Se toma la primera fila donde se reconozca la columna del nombre.
       */
      function buscarEncabezado(filas) {
        for (let i = 0; i < Math.min(filas.length, 15); i++) {
          const mapa = {};
          filas[i].forEach((celda, n) => {
            const campo = queColumnaEs(celda);
            if (campo && mapa[campo] === undefined) mapa[campo] = n;
          });
          if (mapa.nombre !== undefined) return { fila: i, mapa };
        }
        return null;
      }

      // Un CSV chico, hecho a mano: no vale la pena otra librería para esto.
      // Contempla comillas, y separador coma o punto y coma (Excel en español
      // guarda con punto y coma).
      function leerCSV(texto) {
        const sep = (texto.split("\n")[0].match(/;/g) || []).length >
                    (texto.split("\n")[0].match(/,/g) || []).length ? ";" : ",";
        const filas = [];
        let fila = [], campo = "", entreComillas = false;

        for (let i = 0; i < texto.length; i++) {
          const ch = texto[i];
          if (entreComillas) {
            if (ch === '"') {
              if (texto[i + 1] === '"') { campo += '"'; i++; }
              else entreComillas = false;
            } else campo += ch;
          } else if (ch === '"') entreComillas = true;
          else if (ch === sep) { fila.push(campo); campo = ""; }
          else if (ch === "\n") { fila.push(campo); filas.push(fila); fila = []; campo = ""; }
          else if (ch !== "\r") campo += ch;
        }
        if (campo || fila.length) { fila.push(campo); filas.push(fila); }
        return filas;
      }

      let paraImportar = [];

      $("btn-subir-excel").addEventListener("click", () => {
        if (DEMO) { avisarDemo(); return; }
        if (!puedeEditar()) { avisar("El registro está cerrado"); return; }
        $("archivo-excel").value = "";     // permite subir el mismo archivo dos veces
        $("archivo-excel").click();
      });

      $("archivo-excel").addEventListener("change", async (e) => {
        const archivo = e.target.files?.[0];
        if (!archivo) return;

        avisar("Leyendo el archivo…");

        try {
          let filas = [];

          if (/\.csv$/i.test(archivo.name)) {
            filas = leerCSV(await archivo.text());
          } else {
            const { default: ExcelJS } = await import("exceljs");
            const libro = new ExcelJS.Workbook();
            await libro.xlsx.load(await archivo.arrayBuffer());
            const hoja = libro.worksheets[0];
            if (!hoja) throw new Error("El archivo no tiene ninguna hoja.");

            hoja.eachRow({ includeEmpty: false }, (fila) => {
              const valores = [];
              fila.eachCell({ includeEmpty: true }, (celda, n) => {
                const v = celda.value;
                valores[n - 1] =
                  v == null ? ""
                  : typeof v === "object"
                    ? (v.text ?? v.result ?? v.richText?.map((r) => r.text).join("") ?? "")
                    : v;
              });
              filas.push(valores);
            });
          }

          const encabezado = buscarEncabezado(filas);
          if (!encabezado) {
            avisar("No encontré una columna de nombres");
            mostrarError(
              "importar-error",
              "No encontré ninguna columna que se llame Nombre, Invitado o Familia. " +
              "Ponele ese título a la columna de los nombres y volvé a subirlo."
            );
            ver($("modal-importar"), true);
            $("imp-resumen").textContent = archivo.name;
            $("imp-columnas").innerHTML = "";
            $("imp-tabla").innerHTML = "";
            ver($("imp-aviso"), false);
            $("btn-importar-confirmar").disabled = true;
            return;
          }

          const { fila: filaTitulos, mapa } = encabezado;
          const yaEstan = new Set(invitados.map((i) => normalizar(i.nombre)));
          const repetidos = [];
          paraImportar = [];

          for (let i = filaTitulos + 1; i < filas.length; i++) {
            const nombre = String(filas[i][mapa.nombre] ?? "").trim();
            if (!nombre) continue;                      // fila vacía o separador

            if (yaEstan.has(normalizar(nombre))) { repetidos.push(nombre); continue; }
            yaEstan.add(normalizar(nombre));

            const crudoPases = mapa.pases !== undefined ? filas[i][mapa.pases] : null;
            const pases = Math.min(Math.max(parseInt(crudoPases, 10) || 1, 1), 30);

            const crudoMesa = mapa.mesa !== undefined ? filas[i][mapa.mesa] : null;
            const mesa = parseInt(crudoMesa, 10) || null;

            paraImportar.push({ nombre: nombre.slice(0, 80), pases, mesa });
          }

          // ── Pantalla de revisión ──
          mostrarError("importar-error", "");
          $("imp-resumen").textContent =
            archivo.name + "  ·  " + paraImportar.length +
            (paraImportar.length === 1 ? " invitado" : " invitados");

          const nombresCol = { nombre: "Nombre", pases: "Pases", mesa: "Mesa" };
          $("imp-columnas").innerHTML = "";
          for (const campo of ["nombre", "pases", "mesa"]) {
            if (campo === "mesa" && !tiene("mesa")) continue;
            const encontrada = mapa[campo] !== undefined;
            const caja = document.createElement("div");
            caja.className = "fn-card";
            caja.style.cursor = "default";
            caja.innerHTML =
              '<span class="fn-icono"></span>' +
              '<span class="fn-texto"><strong>' + nombresCol[campo] + "</strong></span>" +
              '<span class="marca-conf ' + (encontrada ? "marca-si" : "marca-pendiente") + '">' +
              (encontrada
                ? String(filas[filaTitulos][mapa[campo]] ?? "").trim() || "columna " + (mapa[campo] + 1)
                : campo === "pases" ? "sin columna · va 1" : "no está") +
              "</span>";
            $("imp-columnas").append(caja);
          }

          $("imp-tabla").innerHTML = "";
          for (const inv of paraImportar.slice(0, 5)) {
            const tr = document.createElement("tr");
            const td1 = document.createElement("td");
            td1.dataset.rotulo = "Invitado";
            td1.className = "celda-nombre";
            td1.textContent = inv.nombre;
            const td2 = document.createElement("td");
            td2.dataset.rotulo = "Pases";
            td2.textContent = String(inv.pases);
            tr.append(td1, td2);
            if (tiene("mesa")) {
              const td3 = document.createElement("td");
              td3.dataset.rotulo = "Mesa";
              td3.textContent = inv.mesa ?? "—";
              tr.append(td3);
            }
            $("imp-tabla").append(tr);
          }

          const avisos = [];
          if (repetidos.length) {
            avisos.push(
              repetidos.length + (repetidos.length === 1 ? " nombre ya estaba" : " nombres ya estaban") +
              " en la lista y se saltean: " + repetidos.slice(0, 5).join(", ") +
              (repetidos.length > 5 ? "…" : "")
            );
          }
          if (mapa.pases === undefined) {
            avisos.push("No había columna de pases: todos entran con 1 y se corrigen después.");
          }
          $("imp-aviso").textContent = avisos.join("  ");
          ver($("imp-aviso"), avisos.length > 0);

          $("btn-importar-confirmar").disabled = paraImportar.length === 0;
          $("btn-importar-confirmar").textContent =
            paraImportar.length ? "Agregar " + paraImportar.length : "No hay nada para agregar";

          ver($("modal-importar"), true);
        } catch (err) {
          avisar("No se pudo leer el archivo");
          console.error(err);
          mostrarError("importar-error", "No se pudo leer el archivo: " + (err?.message || err));
          ver($("modal-importar"), true);
        }
      });

      $("btn-importar-confirmar").addEventListener("click", async () => {
        if (!paraImportar.length || !bodaActual) return;

        const boton = $("btn-importar-confirmar");
        boton.disabled = true;
        mostrarError("importar-error", "");

        const conMesa = tiene("mesa");
        const sinPases = bodaActual.funciones?.pases === false;
        const pendientes = paraImportar.map((x) => ({
          nombre: x.nombre,
          pases: sinPases ? 1 : x.pases,
          ...(conMesa ? { mesa: x.mesa } : {}),
          boda_id: bodaActual.id,
        }));

        let guardados = 0;

        // De a 50: una sola consulta por tanda en vez de una por invitado.
        for (let i = 0; i < pendientes.length; i += 50) {
          const tanda = pendientes.slice(i, i + 50);
          let ok = false;

          // Los códigos son al azar; si alguno choca con uno existente se
          // rehace la tanda con códigos nuevos.
          for (let intento = 0; intento < 4 && !ok; intento++) {
            boton.textContent = "Agregando… " + guardados + "/" + pendientes.length;

            const { data, error } = await supabase
              .from("invitados")
              .insert(tanda.map((x) => ({ ...x, codigo: generarCodigo() })))
              .select(COLUMNAS);

            if (!error) {
              for (const fila of data ?? []) {
                if (!invitados.some((i) => i.id === fila.id)) invitados.unshift(fila);
              }
              guardados += tanda.length;
              ok = true;
            } else if (error.code !== "23505") {
              mostrarError("importar-error", traducirError(error));
              boton.disabled = false;
              boton.textContent = "Agregar";
              pintarLista();
              return;
            }
          }

          if (!ok) {
            mostrarError("importar-error", "No se pudieron generar códigos únicos. Probá de nuevo.");
            break;
          }
        }

        boton.disabled = false;
        boton.textContent = "Agregar";
        cerrarModales();
        pintarLista();
        avisar(guardados + (guardados === 1 ? " invitado agregado" : " invitados agregados"));
      });

      // ═══ ARRANQUE ═══
      function fallo(titulo, detalle) {
        $("carga-texto").classList.add("oculto");
        const caja = $("carga-error");
        caja.innerHTML =
          "<strong>" + titulo + "</strong><br><span style='opacity:.85'>" + detalle + "</span>";
        caja.classList.remove("oculto");
      }

      // Cualquier error suelto se muestra en pantalla. Sin esto, un fallo deja
      // el panel colgado en "Cargando…" sin decir qué pasó, y desde afuera
      // parece que el sitio está roto.
      window.addEventListener("error", (e) => {
        if ($("pantalla-carga").classList.contains("oculto")) return;
        fallo("Error al iniciar el panel", String(e.message || e));
      });

      /**
       * Si la base no contesta en unos segundos se sigue igual, en vez de
       * esperar para siempre. Pasa con un proyecto de Supabase pausado o mal
       * configurado: la petición se queda colgada sin fallar nunca.
       */
      function conLimite(promesa, ms = 8000) {
        return Promise.race([
          promesa,
          new Promise((_, rechazar) =>
            setTimeout(() => rechazar(new Error("La base de datos no respondió a tiempo")), ms)
          ),
        ]);
      }

      (async () => {
        // El modo demo no toca la base: se dibuja y listo.
        if (DEMO) {
          try {
            arrancarDemo();
          } catch (e) {
            fallo("Error en el modo demo", String(e?.message || e));
          }
          return;
        }

        // Sin variables de entorno no hay nada que hacer: avisar en vez de
        // dejar la pantalla colgada en "Cargando…"
        if (!configurado) {
          fallo(
            "Falta la configuración de Supabase",
            "Las variables PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_KEY no llegaron al build. " +
            "Agrégalas en Vercel → Settings → Environment Variables y vuelve a desplegar " +
            "(Deployments → ⋯ → Redeploy)."
          );
          return;
        }

        try {
          const { data } = await conLimite(supabase.auth.getSession());
          if (data?.session) await entrar();
          else pantalla("pantalla-login");
        } catch (e) {
          fallo(
            "No se pudo conectar con la base de datos",
            String(e?.message || e) +
              ". Revisá que PUBLIC_SUPABASE_URL apunte a un proyecto que exista y no esté pausado."
          );
        }
      })();
    </script>
  </body>
</html>
